class <%= migration_class_name %> < ActiveRecord::Migration[<%= Rails::VERSION::MAJOR %>.<%= Rails::VERSION::MINOR %>]
  def change
    add_column :<%= table_name %>, :verification_nonce, :string unless column_exists?(:<%= table_name %>, :verification_nonce)
    add_column :<%= table_name %>, :verified_at, :datetime unless column_exists?(:<%= table_name %>, :verified_at)
    add_column :<%= table_name %>, :verification_version, :bigint, default: 0, null: false unless column_exists?(:<%= table_name %>, :verification_version)
    add_column :<%= table_name %>, :verification_attempts, :bigint, default: 0, null: false unless column_exists?(:<%= table_name %>, :verification_attempts)
    add_column :<%= table_name %>, :verification_locked_at, :datetime unless column_exists?(:<%= table_name %>, :verification_locked_at)
    add_index :<%= table_name %>, :verified_at unless index_exists?(:<%= table_name %>, :verified_at)
  end
end
