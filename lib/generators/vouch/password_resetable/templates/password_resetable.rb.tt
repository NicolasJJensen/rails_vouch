class <%= migration_class_name %> < ActiveRecord::Migration[<%= Rails::VERSION::MAJOR %>.<%= Rails::VERSION::MINOR %>]
  def change
    change_table :<%= table_name %> do |t|
<% if selected_token_strategy == "signed" -%>
      t.string :password_reset_nonce unless column_exists?(:<%= table_name %>, :password_reset_nonce)
<% else -%>
      t.string :password_reset_token_digest, index: { unique: true } unless column_exists?(:<%= table_name %>, :password_reset_token_digest)
      t.datetime :password_reset_sent_at unless column_exists?(:<%= table_name %>, :password_reset_sent_at)
<% end -%>
    end
<% if selected_token_strategy == "opaque" -%>

    unless index_exists?(:<%= table_name %>, :password_reset_token_digest, unique: true)
      remove_index :<%= table_name %>, :password_reset_token_digest if index_exists?(:<%= table_name %>, :password_reset_token_digest)
      add_index :<%= table_name %>, :password_reset_token_digest, unique: true
    end
<% end -%>

    reversible do |direction|
      direction.up do
        columns = %w[password_reset_nonce password_reset_token_digest password_reset_sent_at].select do |column|
          column_exists?(:<%= table_name %>, column)
        end
        assignments = columns.map { |column| "#{connection.quote_column_name(column)} = NULL" }.join(", ")
        execute "UPDATE #{connection.quote_table_name(:<%= table_name %>)} SET #{assignments}"
      end
    end
  end
end
