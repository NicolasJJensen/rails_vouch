class <%= migration_class_name %> < ActiveRecord::Migration[<%= Rails::VERSION::MAJOR %>.<%= Rails::VERSION::MINOR %>]
  def change
    create_table :<%= model_table(@identity_class) %><%= ", id: :#{primary_key_type}" if primary_key_type %> do |t|
<% [@account_class, @tenant_class].compact.each do |owner| -%>
<% metadata = model_metadata(owner) -%>
<% metadata.primary_keys.zip(metadata.foreign_keys).each do |key, foreign| -%>
<% if metadata.primary_keys == ["id"] -%>
      t.references :<%= metadata.association_key %>, null: false, type: :<%= primary_key_type || metadata.primary_key_types[key] %>, foreign_key: {to_table: :<%= metadata.table_name %>}
<% else -%>
      t.<%= primary_key_type || metadata.primary_key_types[key] %> :<%= foreign %>, null: false
<% end -%>
<% end -%>
<% end -%>
      t.timestamps
<% [@account_class, @tenant_class].compact.each do |owner| -%>
<% metadata = model_metadata(owner) -%>
<% unless metadata.primary_keys == ["id"] -%>
      t.index <%= metadata.foreign_keys.inspect %>, name: "<%= index_name(model_table(@identity_class), metadata.foreign_keys.join('_')) %>"
      t.foreign_key :<%= metadata.table_name %>, column: <%= metadata.foreign_keys.one? ? metadata.foreign_keys.first.to_sym.inspect : metadata.foreign_keys.inspect %>, primary_key: <%= metadata.primary_keys.one? ? metadata.primary_keys.first.to_sym.inspect : metadata.primary_keys.inspect %>
<% end -%>
<% end -%>
    end
  end
end
