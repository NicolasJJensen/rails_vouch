<h1>Sign in</h1>

<%% if flash[:alert] %>
  <p role="alert"><%%= flash[:alert] %></p>
<%% end %>

<%%= form_with scope: :<%= @account_param_key %>, url: vouch_route_path(:sessions, :create), method: :post do |form| %>
  <p>
    <%%= form.label :email_address, "Email address" %>
    <%%= form.email_field :email_address, value: params.dig(:<%= @account_param_key %>, :email_address), autocomplete: "email", required: true %>
  </p>
  <p>
    <%%= form.label :password, "Password" %>
    <%%= form.password_field :password, autocomplete: "current-password", required: true %>
  </p>
  <%%= form.submit "Sign in" %>
<%% end %>

<p><%%= link_to "Create an account", vouch_route_path(:registrations, :new) %></p>
