class <%= @controller_class %> < Vouch::<%= @controller_base %>
<% if @controller_base == "SessionsController" -%>
  rate_limit to: 10, within: 3.minutes, only: :confirm, name: "authentication_confirmation"
<% end -%>
<% unless @controller_class.deconstantize.underscore.split("/").last.singularize == @controller_route_scope.to_s -%>
  auth_scope :<%= @controller_route_scope %>
<% end -%>
<% if @controller_base == "RegistrationsController" && @tenant_class -%>

  private

  def build_tenant(_account)
    <%= model_metadata(@tenant_class).class_name %>.new
  end
<% end -%>
<% if @account_registration -%>

  private

  def build_identity(account, tenant: nil)
    <%= @identity_class %>.new(<%= model_association(@account_class) %>: account<%= ", #{model_association(@tenant_class)}: tenant" if @tenant_class %>)
  end
<% end -%>
end
