class <%= migration_class_name %> < ActiveRecord::Migration[<%= Rails::VERSION::MAJOR %>.<%= Rails::VERSION::MINOR %>]
  def change
    enable_extension "citext" unless extension_enabled?("citext")

    create_table :<%= model_table(@account_class) %><%= ", id: :#{primary_key_type}" if primary_key_type %> do |t|
      t.citext :email_address, null: false, index: { unique: true }
      t.string :password_digest, null: false
      t.bigint :auth_session_version, null: false, default: 0
      t.timestamps
    end
  end
end
