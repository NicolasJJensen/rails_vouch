class <%= @account_class %> < ApplicationRecord
  self.table_name = "<%= model_table(@account_class) %>"
  include Vouch::Authenticatable

  has_secure_password

  validate do
    errors.delete(:password, :blank) if password_digest.nil? && password.nil?
  end

  normalizes :email_address, with: ->(value) { value.strip.downcase }
  validates :email_address, presence: true, uniqueness: true
<% unless @single_model -%>

  has_many :<%= model_association(@identity_class).pluralize %>, class_name: "<%= @identity_class %>", <%= model_has_many_options(@account_class) %>
<% end -%>
end
