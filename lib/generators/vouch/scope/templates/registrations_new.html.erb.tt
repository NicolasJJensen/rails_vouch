<h1>Create an account</h1>

<%% if @<%= @controller_route_scope %>.errors.any? %>
  <div role="alert"><%%= @<%= @controller_route_scope %>.errors.full_messages.to_sentence %></div>
<%% end %>

<%%= form_with model: @<%= @controller_route_scope %>, url: vouch_route_path(:registrations, :create), scope: :<%= @account_param_key %>, method: :post do |form| %>
  <p>
    <%%= form.label :email_address %>
    <%% if invitation_registration? %>
      <%%= @<%= @controller_route_scope %>.email_address %>
    <%% else %>
      <%%= form.email_field :email_address, value: @<%= @controller_route_scope %>.email_address, autocomplete: "email", required: true %>
    <%% end %>
  </p>
<%% unless oauth_registration? %>
  <p>
    <%%= form.label :password %>
    <%%= form.password_field :password, autocomplete: "new-password", required: true %>
  </p>
  <p>
    <%%= form.label :password_confirmation %>
    <%%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
  </p>
<%% end %>
  <%%= form.submit "Create account" %>
<%% end %>
