class <%= controller_class_name %> < Vouch::ImpersonationsController
<% unless scope.camelize.underscore.split("/").last.singularize == auth_scope_name.to_s -%>
  auth_scope :<%= auth_scope_name %>
<% end -%>

  def create
    # Authorize impersonator's access to @identity here.
    super
  end
end
