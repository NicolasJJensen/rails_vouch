class <%= migration_class_name %> < ActiveRecord::Migration[<%= Rails::VERSION::MAJOR %>.<%= Rails::VERSION::MINOR %>]
  def change
    create_table :<%= join_table_name %><%= ", id: :#{primary_key_type}" if primary_key_type %> do |t|
<% parent_metadata.primary_keys.zip(parent_metadata.foreign_keys(parent_singular)).each do |key, foreign| -%>
      t.<%= primary_key_type || parent_metadata.primary_key_types[key] %> :<%= foreign %>, null: false
<% end -%>
      t.string :code_digest, null: false
      t.datetime :used_at
      t.timestamps
    end
    add_index :<%= join_table_name %>, :used_at
    add_index :<%= join_table_name %>, <%= parent_metadata.foreign_keys(parent_singular).inspect %>
    add_foreign_key :<%= join_table_name %>, :<%= parent_metadata.table_name %>, column: <%= parent_metadata.foreign_keys(parent_singular).one? ? parent_metadata.foreign_keys(parent_singular).first.to_sym.inspect : parent_metadata.foreign_keys(parent_singular).inspect %>, primary_key: <%= parent_metadata.primary_keys.one? ? parent_metadata.primary_keys.first.to_sym.inspect : parent_metadata.primary_keys.inspect %>
  end
end
