# frozen_string_literal: true

# Invitation authorization and account provisioning are host-owned policy.
class <%= scope_module %>::InvitationsController < Vouch::InvitationsController
<% unless controller_scope_path.camelize.underscore.split("/").last.singularize == auth_scope_name.to_s -%>
  auth_scope :<%= auth_scope_name %>
<% end -%>

  on_invitation_token_generation do |identifier, invitation|
    <%= scope_module %>::InvitationMailer.invitation(identifier, invitation).deliver_later
  end

  def create
    # Authorize @invitation using your application's permissions.
    super
  end

  def resend
    # Authorize @invitation using your application's permissions.
    super
  end

  private

  def build_invited_account(identifier)
    normalized_identifier = identifier.to_s.strip.downcase
    <%= invitation_account_class %>.find_by(email_address: normalized_identifier) || <%= invitation_account_class %>.new(
      email_address: normalized_identifier,
      registration_required: true
    )
  end
end
