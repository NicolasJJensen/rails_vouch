<h1>Invitation</h1>
<p>You have been invited to join.</p>

<%% if @receiving_account %>
  <%%= button_to "Add to my account", vouch_route_path(:invitations, :accept),
    params: { token: @invitation.invitation_token, choice: "current" } %>
<%% else %>
  <%%= button_to "Sign in to an existing account", vouch_route_path(:invitations, :accept),
    params: { token: @invitation.invitation_token, choice: "existing" } %>
  <%% if @registration_required %>
    <%%= button_to "Register a new account", vouch_route_path(:invitations, :accept),
      params: { token: @invitation.invitation_token, choice: "new" } %>
  <%% end %>
<%% end %>

<%%= button_to "Reject invitation", vouch_route_path(:invitations, :reject),
  params: { token: @invitation.invitation_token } %>
