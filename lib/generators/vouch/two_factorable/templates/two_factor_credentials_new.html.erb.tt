<h1>Enroll a two-factor credential</h1>
<%% if @credential.nil? %>
  <%% credential_associations.each do |association| %>
    <%%= link_to "Add #{association.klass.model_name.human.downcase}", vouch_route_path(:two_factor_credentials, :new, credential_kind: association.name) %>
  <%% end %>
<%% else %>
  <%% if @credential.errors.any? %>
    <p><%%= @credential.errors.full_messages.to_sentence %></p>
  <%% end %>
  <%% if @awaiting_verification %>
    <%%= form_with url: vouch_route_path(:two_factor_credentials, :update, id: Vouch::RecordKey.to_param(@credential), credential_kind: @credential_kind), method: :patch do |form| %>
      <%%= form.label :code, "Verification code" %>
      <%%= form.text_field :code, required: true, autocomplete: "one-time-code" %>
      <%%= form.submit "Verify and enable" %>
    <%% end %>
    <%%= button_to "Resend verification code", vouch_route_path(:two_factor_credentials, :send_code, id: Vouch::RecordKey.to_param(@credential), credential_kind: @credential_kind), method: :post %>
  <%% else %>
    <%%= form_with model: @credential, url: vouch_route_path(:two_factor_credentials, :create, credential_kind: @credential_kind), method: :post do |form| %>
      <%% credential_subject_attributes.each do |attribute| %>
        <%%= form.label attribute %>
        <%%= form.text_field attribute, required: true %>
      <%% end %>
      <%%= form.submit "Send verification code" %>
    <%% end %>
  <%% end %>
<%% end %>
