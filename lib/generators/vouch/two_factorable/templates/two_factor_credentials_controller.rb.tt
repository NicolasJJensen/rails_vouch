class <%= controller_scope_path.camelize %>::TwoFactorCredentialsController < Vouch::TwoFactorCredentialsController
<% unless controller_scope_path.camelize.underscore.split("/").last.singularize == auth_scope_name.to_s -%>
  auth_scope :<%= auth_scope_name %>
<% end -%>
  rate_limit to: 5, within: 3.minutes, only: %i[create send_code],
    by: -> { Vouch::RecordKey.to_param(current_account) }, name: "enrollment_delivery"
  helper_method :credential_associations, :credential_subject_attributes

  def index
    @credentials_by_kind = credential_associations.to_h do |association|
      [association.name, current_account.public_send(association.name)]
    end
  end

  def edit
    @awaiting_verification = !@credential.verified?
  end

  def create
    return if performed?

    result = credential_operation { Vouch::Persistence.save!(@credential) }
    result = send_enrollment_code if result.ok?
    set_operation_result(result)
  end

  def send_code
    return if performed?

    set_operation_result(send_enrollment_code)
  end

  def update
    return if performed?

    result = credential_operation do
      @credential.lock!
      verification = @credential.verified? ? Vouch::Result.ok(@credential) :
        @credential.complete_verification(params[:code], token: session[enrollment_session_key])
      if verification.ok?
        @credential.enable_two_factor!
        current_account.enable_two_factor!
      end
      verification
    end
    session.delete(enrollment_session_key) if result.ok?
    unless result.ok?
      @credential.errors.add(:base, "The verification code is invalid, expired, or locked") if @credential.errors.empty?
      @awaiting_verification = true
    end
    set_operation_result(result)
  end

  private

  def default_render
    return if performed?
    if action_name == "edit"
      return render :new if @awaiting_verification

      return redirect_to vouch_route_path(:two_factor_credentials, :index)
    end
    return super unless @_vouch_operation_result

    case action_name
    when "create", "send_code"
      if @operation_status == :already_verified
        redirect_to vouch_route_path(:two_factor_credentials, :index)
      else
        render :new, status: @operation_status == :ok ? :accepted : :unprocessable_entity
      end
    when "update"
      if @operation_status == :ok
        redirect_to vouch_route_path(:two_factor_credentials, :index), notice: "Two-factor credential enabled"
      else
        render :new, status: :unprocessable_entity
      end
    else
      super
    end
  end

  def send_enrollment_code
    result = @credential.start_verification
    session[enrollment_session_key] = result.token if result.ok?
    @awaiting_verification = !@credential.verified?
    unless result.ok? || result.already_verified? || @credential.errors.any?
      @credential.errors.add(:base, I18n.t("vouch.two_factor_credentials.verification_unavailable"))
    end
    result
  end

  def credential_relation
    @vouch_account = current_account
    expose_authentication_records
    association = if params[:credential_kind].present?
      credential_associations.find { |candidate| candidate.name.to_s == params[:credential_kind] }
    elsif credential_associations.one?
      credential_associations.first
    end
    raise ActiveRecord::RecordNotFound unless association

    @credential_kind = association.name
    @vouch_account.public_send(association.name)
  end

  def credential_associations
    auth_mapping.two_factor_credential_associations.select do |association|
      association.klass.include?(Vouch::Verifiable)
    end
  end

  def build_credential
    return if action_name == "new" && params[:credential_kind].blank? && !credential_associations.one?

    @credential = credential_relation.new
    @credential.assign_attributes(credential_params) if action_name == "create"
  rescue ActiveRecord::RecordNotFound
    head :not_found
  end

  def set_credential
    @credential = Vouch::RecordKey.find(credential_relation, params[:id])
  rescue ActiveRecord::RecordNotFound
    head :not_found
  end

  def enrollment_session_key
    "warden.#{auth_scope_name}.enrollment.#{@credential.model_name.singular}.#{Vouch::RecordKey.to_param(@credential)}"
  end

  def credential_params
    params.require(@credential.model_name.param_key).permit(*credential_subject_attributes)
  end

  def credential_subject_attributes
    attributes = Array(@credential.class.verifiable_subject_attribute)
    if attributes.empty?
      raise Vouch::ConfigurationError, "Set verifiable_subject_attribute on #{@credential.class.name} before enrolling this credential."
    end
    attributes
  end
end
