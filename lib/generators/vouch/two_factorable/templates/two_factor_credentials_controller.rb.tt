class <%= controller_scope_path.camelize %>::TwoFactorCredentialsController < Vouch::TwoFactorCredentialsController
<% unless controller_scope_path.camelize.underscore.split("/").last.singularize == auth_scope_name.to_s -%>
  auth_scope :<%= auth_scope_name %>
<% end -%>

  def create(&response_handler)
    return if performed?

    result = credential_operation { Vouch::Persistence.save!(@credential) }
    result = @credential.start_verification if result.ok?
    if result.ok?
      session[enrollment_session_key] = result.token
      @awaiting_verification = true
    end
    respond_with_authentication_result(result, response_handler) do
      render :new, status: result.ok? ? :accepted : :unprocessable_entity
    end
  end

  def update(&response_handler)
    return if performed?

    result = credential_operation do
      @credential.lock!
      verification = @credential.verified? ? Vouch::Result.ok(@credential) :
        @credential.complete_verification(params[:code], token: session[enrollment_session_key])
      if verification.ok?
        @credential.enable_two_factor!
        current_account.enable_two_factor!
      end
      verification
    end
    session.delete(enrollment_session_key) if result.ok?
    respond_with_authentication_result(result, response_handler) do
      if result.ok?
        redirect_to <%= route_helper_prefix %>_two_factor_credentials_path, notice: "Two-factor credential enabled"
      else
        @credential.errors.add(:base, "The verification code is invalid, expired, or locked") if @credential.errors.empty?
        @awaiting_verification = true
        render :new, status: :unprocessable_entity
      end
    end
  end

  private

  def credential_relation
    current_account.<%= credential_association_name %>
  end

  def set_credential
    @credential = Vouch::RecordKey.find(credential_relation, params[:id])
  rescue ActiveRecord::RecordNotFound
    head :not_found
  end

  def enrollment_session_key
    "warden.#{auth_scope_name}.enrollment.#{@credential.model_name.singular}.#{Vouch::RecordKey.to_param(@credential)}"
  end

  def credential_params
    params.require(:<%= model_metadata.param_key %>).permit(<%= permitted_subject_attributes %>)
  end
end
