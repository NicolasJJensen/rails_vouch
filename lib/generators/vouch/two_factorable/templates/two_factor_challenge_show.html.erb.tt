<h1>Enter verification code</h1>

<%% if flash[:alert] %>
  <p role="alert"><%%= flash[:alert] %></p>
<%% end %>

<%% credential_param = "#{@credential.model_name.singular}-#{Vouch::RecordKey.to_param(@credential)}" %>
<%%= form_with url: vouch_route_path(:two_factor_challenges, :update, id: credential_param), method: :patch do %>
  <p>
    <%%= label_tag :code, "Verification code" %>
    <%%= text_field_tag :code, nil, autocomplete: "one-time-code", required: true %>
  </p>
  <%%= submit_tag "Verify" %>
<%% end %>

<%%= button_to "Send another code", vouch_route_path(:two_factor_challenges, :send_code, id: credential_param), method: :post %>

<%%= button_to "Cancel", vouch_route_path(:two_factor_challenges, :destroy), method: :delete %>
