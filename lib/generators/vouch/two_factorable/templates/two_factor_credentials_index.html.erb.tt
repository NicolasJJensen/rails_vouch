<h1>Two-factor credentials</h1>
<%% @credentials_by_kind.each do |kind, credentials| %>
  <h2><%%= credentials.klass.model_name.human.pluralize %></h2>
  <%% credentials.each do |credential| %>
    <p><%%= credential.two_factor_label %> — <%%= credential.verified? ? "verified" : "pending" %></p>
    <%% if credential.verified? && !credential.two_factor_enabled? %>
      <%%= button_to "Enable two-factor authentication", vouch_route_path(:two_factor_credentials, :update, id: Vouch::RecordKey.to_param(credential), credential_kind: kind), method: :patch %>
    <%% elsif !credential.verified? %>
      <%%= link_to "Continue verification", vouch_route_path(:two_factor_credentials, :edit, id: Vouch::RecordKey.to_param(credential), credential_kind: kind) %>
    <%% end %>
    <%%= button_to "Remove credential", vouch_route_path(:two_factor_credentials, :destroy, id: Vouch::RecordKey.to_param(credential), credential_kind: kind), method: :delete %>
  <%% end %>
  <%%= link_to "Add #{credentials.klass.model_name.human.downcase}", vouch_route_path(:two_factor_credentials, :new, credential_kind: kind) %>
<%% end %>
