<h1>Two-factor credentials</h1>
<%% @credentials.each do |credential| %>
  <p><%%= credential.class.name %> — <%%= credential.verified? ? "verified" : "pending" %></p>
  <%% if credential.verified? && !credential.two_factor_enabled? %>
    <%%= button_to "Enable two-factor authentication", <%= route_helper_prefix %>_two_factor_credential_path(Vouch::RecordKey.to_param(credential)), method: :patch %>
  <%% end %>
  <%%= button_to "Remove credential", <%= route_helper_prefix %>_two_factor_credential_path(Vouch::RecordKey.to_param(credential)), method: :delete %>
<%% end %>
<%%= link_to "Add credential", new_<%= route_helper_prefix %>_two_factor_credential_path %>
