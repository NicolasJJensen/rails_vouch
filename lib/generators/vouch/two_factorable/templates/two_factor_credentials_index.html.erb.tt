<h1>Two-factor credentials</h1>
<%% @credentials.each do |credential| %>
  <p><%%= credential.class.name %> — <%%= credential.verified? ? "verified" : "pending" %></p>
  <%% if credential.verified? && !credential.two_factor_enabled? %>
    <%%= button_to "Enable two-factor authentication", vouch_route_path(:two_factor_credentials, :update, id: Vouch::RecordKey.to_param(credential)), method: :patch %>
  <%% end %>
  <%%= button_to "Remove credential", vouch_route_path(:two_factor_credentials, :destroy, id: Vouch::RecordKey.to_param(credential)), method: :delete %>
<%% end %>
<%%= link_to "Add credential", vouch_route_path(:two_factor_credentials, :new) %>
