<h1>Choose an MFA method</h1>

<ul>
  <%% @credentials.each do |credential| %>
    <%% credential_param = "#{credential.model_name.singular}-#{Vouch::RecordKey.to_param(credential)}" %>
    <li><%%= link_to credential.two_factor_label, <%= route_helper_prefix %>_two_factor_challenge_path(credential_param) %></li>
  <%% end %>
</ul>

<%% if @enrollment_required %>
  <p>No eligible authentication methods are available.</p>
  <p><%%= link_to "Add an authentication method", <%= route_helper_prefix %>_two_factor_credentials_path %></p>
<%% end %>

<%% if @recovery_available %>
  <p><%%= link_to "Use a recovery code", <%= route_helper_prefix %>_recovery_two_factor_challenge_path %></p>
<%% end %>

<%%= button_to "Cancel", <%= route_helper_prefix %>_two_factor_challenges_path, method: :delete %>
